# MISC
NODE_ENV=development

# Public application origin used in completion emails (e.g. https://chaptify.app).
# Not to be confused with Nuxt's reserved NUXT_APP_BASE_URL (a route path prefix).
NUXT_SITE_URL=http://localhost:3000

# Cloudflare Web Analytics (RUM) beacon token. Public by design (embedded in the page HTML).
# Leave blank to disable analytics entirely. `npm run dev` never loads the beacon even when set
# (Cloudflare only accepts the registered production hostname). Get it from the Cloudflare dashboard:
# Analytics & Logs -> Web Analytics -> add the site with the manual JS snippet (the app hostname is
# DNS-only/grey-cloud, so automatic injection is not available) and copy the token.
NUXT_PUBLIC_CLOUDFLARE_BEACON_TOKEN=

# Public domain for the PRODUCTION Docker overlay (docker-compose.prod.yml). Caddy serves this host
# and requests a Let's Encrypt certificate for it. Only read by the prod overlay; leave blank for
# local development, Docker smoke, and CI (which use the base compose file alone).
DOMAIN=
# Production only: uncomment on the VPS so every `docker compose` command includes the prod overlay
# automatically. Leave unset locally so dev/smoke/CI use the base file alone.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# SHARED-VPS OVERLAY ONLY (docker-compose.vps.yml, not docker-compose.prod.yml). The exact published
# image tag to run — this one line says which build is in production, and setting it back to an
# earlier sha is the rollback. Take the value from a green CI run on main; CI keeps the ten most
# recent, which bounds how far back a rollback can go. Required by that overlay and read by nothing
# else, so leave it commented out for local development, the Docker smoke test, and the prod overlay.
# CHAPTIFY_TAG=sha-1a2b3c4

# Runtime storage. Keep outside the source tree in production.
NUXT_STORAGE_ROOT=.chaptify-storage
NUXT_MAX_UPLOAD_BYTES=1610612736
NUXT_MAX_QUEUED_JOBS=10
NUXT_MAX_CONCURRENT_UPLOADS=2
# Abort an upload after this many seconds of no received data (anti-slowloris).
NUXT_UPLOAD_IDLE_TIMEOUT_SECONDS=30
# Hard ceiling on one upload request, and the average throughput it must sustain (enforced after a
# 15s grace period). The idle timeout above is reset by any traffic, so these two are what stop a
# client trickling a few bytes at a time from holding an upload slot forever. 0 disables either one.
# Keep caddy/Caddyfile's `read_body` timeout above NUXT_UPLOAD_MAX_SECONDS.
NUXT_UPLOAD_MAX_SECONDS=7200
NUXT_UPLOAD_MIN_BYTES_PER_SECOND=16384
# Trusted-proxy policy for resolving the client IP used by per-IP rate limits.
# Both wrong answers here are SILENT, so set it deliberately and confirm it in the startup log
# ("Trusted-proxy policy (NUXT_TRUST_PROXY): ..."), which states the resolved mode on every boot.
# Empty/false: trust only the direct connection (safe default, no reverse proxy). Behind a proxy
# this makes every client share ONE rate-limit identity, so one abuser exhausts everyone's budget.
# true: single trusted proxy; use the right-most X-Forwarded-For hop. Set this ONLY when the app
# has no directly reachable port and every request arrives through that proxy — otherwise a client
# connecting directly can forge its own identity. Requires a proxy that overwrites (not appends)
# X-Forwarded-For; Caddy's reverse_proxy does, verified in docs/deployment.md.
# Comma-separated IPs/IPv4 CIDRs (e.g. "127.0.0.1,::1,172.16.0.0/12"): trust
# X-Forwarded-For only when the peer is a listed proxy. The proxy MUST set
# (not merely append) X-Forwarded-For for this to be safe.
NUXT_TRUST_PROXY=
NUXT_PER_IP_UPLOAD_LIMIT=5
NUXT_PER_IP_JOB_LIMIT=5
NUXT_DOWNLOAD_RATE_LIMIT=30
NUXT_STORAGE_RESERVATION_MULTIPLIER=4
NUXT_STORAGE_RESERVATION_SAFETY_BYTES=268435456
NUXT_STORAGE_RESERVATION_TTL_MINUTES=120
NUXT_ORPHAN_JOB_DIRECTORY_MIN_AGE_MINUTES=30
NUXT_CLEANUP_INTERVAL_SECONDS=300
NUXT_BROWSER_DOWNLOAD_GRANT_LIFETIME_SECONDS=60
NUXT_BROWSER_DOWNLOAD_GRANT_USED_GRACE_SECONDS=300
NUXT_WORKER_CONCURRENCY=1
NUXT_JOB_RETENTION_HOURS=12
NUXT_MAX_AUDIOBOOK_DURATION_SECONDS=108000
NUXT_MAX_CHAPTERS=300
# No-chapters fallback: segment length, and the minimum duration eligible for it.
NUXT_FALLBACK_SEGMENT_SECONDS=1800
NUXT_MIN_SEGMENTED_DURATION_SECONDS=3600
NUXT_JOB_PROCESSING_TIMEOUT_SECONDS=14400
NUXT_FFPROBE_TIMEOUT_SECONDS=30
NUXT_FFMPEG_CHAPTER_TIMEOUT_SECONDS=1200
NUXT_EMAIL_RETRY_ATTEMPTS=3
NUXT_EMAIL_RETRY_BASE_DELAY_SECONDS=60
NUXT_EMAIL_RETRY_MAX_DELAY_SECONDS=3600

# Server-only signing secret for restart-safe emailed download links.
# Use at least 32 random characters in any environment that sends email.
NUXT_DOWNLOAD_SIGNING_SECRET=

# Mailgun. Leave blank locally when email delivery should fail safely in tests/dev.
NUXT_MAILGUN_BASE_URL=
NUXT_MAILGUN_DOMAIN=
NUXT_MAILGUN_KEY=
NUXT_MAILGUN_SENDER=

# Contact form. Submissions are emailed to this inbox via Mailgun; leave blank to disable.
NUXT_CONTACT_RECIPIENT=
# Messages allowed per IP per hour.
NUXT_CONTACT_RATE_LIMIT=5
