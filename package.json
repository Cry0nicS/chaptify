{
    "name": "chaptify",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "api:start": "node .output/start.mjs",
        "build": "nuxt build && npm run worker:build && npm run cleanup:build && npm run start:build",
        "cleanup:build": "esbuild server/cleanup.ts --bundle --platform=node --format=esm --target=node24 --outfile=.output/cleanup.mjs --external:better-sqlite3 --external:mailgun.js --external:formidable --external:archiver",
        "cleanup:dev": "tsx server/cleanup.ts",
        "cleanup:start": "node .output/cleanup.mjs",
        "clean": "npx nuxi cleanup && rm -rf node_modules/ && rm -rf .nuxt/ && rm package-lock.json",
        "dev": "nuxi dev",
        "format": "prettier --write \"**/*.{js,json,jsx,css,ts,tsx,vue}\"",
        "format-check": "prettier --check \"**/*.{html,js,json,jsx,css,ts,tsx,vue,scss}\"",
        "generate": "nuxt generate",
        "lint": "eslint .",
        "lockfile:refresh": "docker run --rm --platform=linux/amd64 -u \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/w -w /w node:24 npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
        "preview": "node .output/start.mjs",
        "postinstall": "nuxt prepare",
        "smoke:docker": "node scripts/docker-smoke.mjs",
        "test": "vitest run",
        "start:build": "esbuild server/start.ts --bundle --platform=node --format=esm --target=node24 --outfile=.output/start.mjs",
        "worker:build": "esbuild server/worker.ts --bundle --platform=node --format=esm --target=node24 --outfile=.output/worker.mjs --external:better-sqlite3 --external:mailgun.js --external:formidable --external:archiver",
        "worker:dev": "tsx server/worker.ts",
        "worker:start": "node .output/worker.mjs",
        "type-check": "nuxt typecheck"
    },
    "dependencies": {
        "archiver": "^8.0.0",
        "better-sqlite3": "^13.0.3",
        "formidable": "^3.5.4",
        "mailgun.js": "^13.3.0"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.3.0",
        "@iconify-json/lucide": "^1.2.123",
        "@iconify-json/simple-icons": "^1.2.93",
        "@nuxt/ui": "~4.10.0",
        "@nuxt/eslint": "^1.17.0",
        "@types/archiver": "^8.0.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/formidable": "^3.5.1",
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.8.1",
        "lint-staged": "^17.3.0",
        "nuxt": "~4.5.2",
        "oxc-parser": "^0.143.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "simple-git-hooks": "^2.13.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.9",
        "zod": "^4.4.3"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    },
    "lint-staged": {
        "*.{html,js,json,css,ts,vue}": "prettier --check",
        "*.{js,ts,vue}": "eslint"
    },
    "allowScripts": {
        "vue-demi@0.14.10": true,
        "@parcel/watcher@2.5.6": true,
        "better-sqlite3@13.0.3": true,
        "esbuild@0.28.2": true,
        "esbuild@0.27.7": true,
        "simple-git-hooks@2.13.1": true,
        "unrs-resolver@1.12.2": true
    }
}
