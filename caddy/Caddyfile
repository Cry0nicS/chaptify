# Chaptify production reverse proxy (used by docker-compose.prod.yml).
#
# Automatic HTTPS: Caddy obtains and auto-renews a Let's Encrypt certificate for {$DOMAIN} using
# the ACME HTTP-01 / TLS-ALPN-01 challenge, which needs ports 80+443 reachable from the internet
# and {$DOMAIN}'s DNS pointing at this host. DOMAIN is injected by the caddy service (from .env).
#
# To also serve www, use:  {$DOMAIN}, www.{$DOMAIN} {

# Global options must be the first block in the file.
{
    servers {
        timeouts {
            # Hard deadline for reading a request (headers plus body) — defense in depth behind the
            # app's own NUXT_UPLOAD_MAX_SECONDS / NUXT_UPLOAD_MIN_BYTES_PER_SECOND bounds, so a
            # trickling upload cannot hold a connection open forever even if the app fails to
            # terminate it. Keep this ABOVE NUXT_UPLOAD_MAX_SECONDS (default 2h) so the app is
            # normally the side that aborts and cleans up the partial upload; raising that variable
            # means raising this too. Downloads are unaffected (they are writes, not reads).
            read_body 3h
            read_header 30s
        }
    }
}

{$DOMAIN} {
    encode zstd gzip

    # Chaptify accepts uploads up to 1.6 GB and enforces its own NUXT_MAX_UPLOAD_BYTES limit.
    # Do NOT add `request_body { max_size ... }` here — it would reject large uploads (413) at the
    # proxy before they reach the app.
    #
    # By default Caddy overwrites X-Forwarded-For with the real connecting client's IP (a
    # client-supplied value is NOT trusted and is dropped), so the app — with NUXT_TRUST_PROXY=true,
    # which reads the right-most hop — always keys per-IP limits on the real client. Caddy reaches
    # the app over the internal compose network.
    reverse_proxy chaptify:3000
}
